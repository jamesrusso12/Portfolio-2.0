# Normalize line endings for text files across platforms
* text=auto eol=lf

# Source files are text
*.html  text
*.css   text
*.js    text
*.md    text
*.json  text
*.sh    text eol=lf

# Known binary assets — prevent line-ending munging
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.mov   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.psd   binary
*.fbx   binary
